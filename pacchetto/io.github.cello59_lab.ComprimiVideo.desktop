[Desktop Entry]
Type=Application
Name=Comprimi Video
GenericName=Video compressor
GenericName[it]=Compressione video
Comment=Reduce the size of videos with ffmpeg (HEVC, H.264, AV1; AMD, Intel, NVIDIA GPU or CPU)
Comment[it]=Riduci le dimensioni dei video con ffmpeg (HEVC, H.264, AV1; GPU AMD, Intel, NVIDIA o CPU)
Exec=comprimi-video %F
Icon=io.github.cello59_lab.ComprimiVideo
MimeType=video/mp4;video/x-matroska;video/quicktime;video/x-msvideo;video/webm;video/x-m4v;video/mp2t;
Terminal=false
StartupNotify=true
StartupWMClass=io.github.cello59_lab.ComprimiVideo
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=ffmpeg;video;compress;compression;hevc;av1;vaapi;nvenc;
Keywords[it]=ffmpeg;video;comprimi;compressione;hevc;av1;vaapi;nvenc;
X-GNOME-UsesNotifications=true
